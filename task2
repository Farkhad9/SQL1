SELECT m.Title,
       m.ReleaseYear,
       a.FullName AS Author,
       g.GenreName AS Genre
FROM Movies m
JOIN Authors a ON m.AuthorId = a.AuthorId
JOIN Genres g ON m.GenreId = g.GenreId;

SELECT Title, ReleaseYear
FROM Movies
WHERE GenreId = 4;

SELECT m.Title, m.ReleaseYear
FROM Movies m
JOIN Genres g ON m.GenreId = g.GenreId
WHERE g.GenreName = 'Sci-Fi';
SELECT m.Title, m.ReleaseYear
FROM Movies m
JOIN Authors a ON m.AuthorId = a.AuthorId
WHERE a.FullName = 'Christopher Nolan';
SELECT g.GenreName,
       COUNT(*) AS MovieCount
FROM Movies m
JOIN Genres g ON m.GenreId = g.GenreId
GROUP BY g.GenreName;










