CREATE DATABASE CARS
USE CARS
CREATE TABLE Brands
(
    Id INT PRIMARY KEY,
    BrandName VARCHAR(30) NOT NULL
);

CREATE TABLE Cars
(
    Id INT PRIMARY KEY,
    Model VARCHAR(40) NOT NULL,
    Year INT,
    Price DECIMAL(10,2),
    BrandId INT,
    FOREIGN KEY (BrandId) REFERENCES Brands(Id)
);
